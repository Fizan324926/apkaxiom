# rules and dependencies land in P1.13 / P1.14.
#
# `bazel info` works against this file alone. Adding rules will require
# expanding `bazel_dep(...)` declarations below.

module(
    name = "apkaxiom_aosp",
    version = "0.0.0",
    compatibility_level = 0,
)

# Pinned Bazel rules. These are placeholders sized for `bazel info` to
# succeed; real AOSP rule sets land in P1.13.
bazel_dep(name = "rules_cc", version = "0.0.17")
bazel_dep(name = "platforms", version = "0.0.10")
