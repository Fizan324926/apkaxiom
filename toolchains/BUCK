# Toolchain registration for the Buck2 root cell. We register the strict
# subset of toolchains needed by our build graph (cxx, genrule, python
# bootstrap, rust, remote-test-execution). Registering everything via
# `system_demo_toolchains()` works but pulls in Go/Haskell/OCaml/Java
# toolchains we never invoke, cluttering `buck2 audit toolchains` and
# inflating the surface area we have to keep reproducible.
#
# The exact set mirrors what `system_demo_toolchains` emits in the bundled
# prelude shipped with the Buck2 binary that flake.lock pins (see
# ADR-0002). The bundled prelude does not expose a `noop_test_toolchain`
# in this version; tests are driven entirely by `remote_test_execution`.

load("@prelude//toolchains:cxx.bzl", "system_cxx_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:python.bzl", "system_python_bootstrap_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")
load("@prelude//toolchains:rust.bzl", "system_rust_toolchain")

system_cxx_toolchain(
    name = "cxx",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    visibility = ["PUBLIC"],
)

# The Rust toolchain reads `rustc` and `cargo` from PATH. Inside `nix
# develop` this is the Nix-pinned toolchain (see flake.nix); outside it is
# whatever the host has. `make repro-check` *requires* `nix develop`, so
# the host fallback is purely for IDE convenience.
system_rust_toolchain(
    name = "rust",
    default_edition = "2021",
    rustc_flags = [
        "--remap-path-prefix=$PWD=.",
    ],
    visibility = ["PUBLIC"],
)

remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)
