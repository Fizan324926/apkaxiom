# APKAXIOM CODEOWNERS — Phase 1.1.
#
# Lines matched against the changed files in a PR; the OWNERS column lists
# review-required teams for that path. Branch protection enforces "code
# owner review required" on `main` (per ADR-0008 §"Provisioning checklist").
#
# When adding a path, prefer the most specific match. The first matching
# rule wins (top-down, last-rule semantics in GitHub's parser).
#
# Convention: every path that participates in the hermetic-build contract
# belongs to G13. Cross-cutting docs default to G13 + project leads.

# ----------------------------------------------------------------------------
# Hermetic-build-foundation assets — G13 (Platform Infrastructure)
# ----------------------------------------------------------------------------
flake.nix                                       @apkaxiom/g13-platform
flake.lock                                      @apkaxiom/g13-platform
rust-toolchain.toml                             @apkaxiom/g13-platform
.buckconfig                                     @apkaxiom/g13-platform
.buckroot                                       @apkaxiom/g13-platform
BUCK                                            @apkaxiom/g13-platform
toolchains/**                                   @apkaxiom/g13-platform
reindeer.toml                                   @apkaxiom/g13-platform
deny.toml                                       @apkaxiom/g13-platform
Makefile                                        @apkaxiom/g13-platform

# Reindeer-managed third-party tree — generated, but G13 reviews drift.
third-party/rust/Cargo.toml                     @apkaxiom/g13-platform
third-party/rust/Cargo.lock                     @apkaxiom/g13-platform
third-party/rust/BUCK                           @apkaxiom/g13-platform
third-party/rust/fixups/**                      @apkaxiom/g13-platform

# Bazel sub-workspace
external/aosp/MODULE.bazel                      @apkaxiom/g13-platform
external/aosp/MODULE.bazel.lock                 @apkaxiom/g13-platform
external/aosp/.bazelrc                          @apkaxiom/g13-platform
external/aosp/.bazelversion                     @apkaxiom/g13-platform
external/aosp/WORKSPACE                         @apkaxiom/g13-platform

# Reproducibility-engineering scripts
scripts/**                                      @apkaxiom/g13-platform

# CI workflows + governance
.github/**                                      @apkaxiom/g13-platform

