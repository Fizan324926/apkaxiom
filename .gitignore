# APKAXIOM .gitignore
# Build artifacts and tool caches. Source-of-truth files (locks, manifests,
# vendored crates, generated BUCK files) are *kept* in git for hermeticity.

# ----- Buck2 -----
/buck-out/
.buck/
.buckd/

# ----- Cargo / Rust -----
/target/
**/target/
*.rs.bk
**/*.rmeta-stamp

# ----- Bazel -----
bazel-bin
bazel-out
bazel-testlogs
bazel-*

# ----- Lean / Lake -----
# Lake builds artefacts and clones deps into .lake/. The committed
# `lake-manifest.json` pins everything by SHA; .lake/ itself is rebuildable.
.lake/

# ----- P1.3 upstream audit input -----
# external/apk-info-upstream is a vendored read-only clone for audit
# purposes. We commit the source (so audit measurements are
# reproducible against the pinned SHA in
# external/apk-info-pinned-sha.txt) but exclude its .git/ — our repo
# is the source of truth, not their git history.
external/apk-info-upstream/.git/
external/apk-info-upstream/target/
external/apk-info-upstream/.lake/

# external/libziparchive — vendored AOSP subset for the P1.5
# differential third prong. See ADR-0016. Build artefacts go into
# build/ which is regenerable, source tree is read-only.
external/libziparchive/.git/
external/libziparchive/build/

# Per-host audit data caches that get regenerated on demand.
docs/phase-1/P1.3/audit-data/perf-runs/

# ----- SBOM tool leftovers -----
# `cargo-cyclonedx` writes one BOM next to each workspace member's
# Cargo.toml. `make sbom` collects + cleans them, but defence in depth:
**/crates/*/*.cdx.json
**/tools/*/*.cdx.json

# ----- P1.5 differential summary -----
# Regenerable; per-host wall-clock varies. The structural agreement
# count IS deterministic and lives in the CHECKLIST.
tools/zip-differential/differential-summary.json

# ----- Nix -----
result
result-*
.direnv/

# ----- Editors / IDEs -----
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ----- Tooling local state (not source of truth) -----
.claude/

# ----- Misc -----
*.log
*.tmp
*.tmp.*

# Cargo runtime state files that `reindeer vendor` regenerates. These are
# NOT source-of-truth — committing them makes `reindeer-check` flap.
**/.cargo/.global-cache
**/.cargo/.package-cache
**/.cargo/.package-cache-mutate

# Reindeer / Cargo lock dirs we explicitly KEEP:
# - Cargo.lock
# - third-party/rust/Cargo.lock
# - third-party/rust/vendor/  (committed for hermeticity)
# - third-party/rust/BUCK     (generated, but committed)
# - third-party/rust/.cargo/registry/  (committed for offline-hermetic
#                                       reindeer; the mutable caches
#                                       above are excluded)
# - flake.lock                (committed)

# P1.7 profile artefacts (regenerable via `make p17-profile`).
docs/phase-1/P1.7/profiles/

# P1.7 §F soak transcripts are sign-off artefacts — keep them
# despite the global *.log rule above.
!docs/phase-1/P1.7/soak/*.log

# P1.8 §F-1 perf-delta artefacts.
!docs/phase-1/P1.8/perf/*.log

# P1.9 §F-1 perf-delta artefacts.
!docs/phase-1/P1.9/*.log

# P1.13 fuzz findings — runtime output (per-run inputs +
# timestamped archive). Regenerated by `make p113-fuzz`.
# The seed corpus is deterministic and committed.
fuzz/findings/
