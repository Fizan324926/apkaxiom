# AXIOM-IR v0.1 — frozen reference IR (core + manifest + resource
# dialects, canonical bytes, lowering, MLIR-style text). The schema is
# pinned by `docs/phase-1/P1.4/ir-data/schema-hash.txt` (CI drift gate
# at `p14-ir-drift`).
#
# Pure-std + thiserror only. We deliberately do NOT pull serde / bincode /
# rkyv / capnp here — see `third-party/rust/Cargo.toml` for the workspace
# dep-minimisation policy. Wire formats are hand-rolled in
# `src/canonical.rs` (deterministic bytes) + `src/json.rs` (drift-stable
# JSON) + `src/text.rs` (MLIR-style human-readable).

rust_library(
    name = "axiom-ir",
    srcs = glob(["src/**/*.rs"]),
    crate = "axiom_ir",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "//third-party/rust:thiserror",
    ],
    visibility = ["PUBLIC"],
)

rust_test(
    name = "axiom-ir-test",
    srcs = glob(["src/**/*.rs"]),
    crate = "axiom_ir",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "//third-party/rust:thiserror",
    ],
)
