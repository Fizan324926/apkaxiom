    name = "axiom-blake3-hacl",
    srcs = glob(["src/**/*.rs"]),
    crate = "axiom_blake3_hacl",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "//third-party/rust:blake3",
    ],
    visibility = ["PUBLIC"],
)

